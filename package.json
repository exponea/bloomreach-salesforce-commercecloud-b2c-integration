{
  "name": "int_bloomreach_engagement",
  "version": "0.0.1",
  "description": "New overlay cartridge",
  "main": "index.js",
  "scripts": {
    "test": "mocha test/**/*.test.js",
    "test:watch": "mocha test/**/*.test.js --watch",
    "test:coverage": "istanbul cover _mocha test/**/*.test.js",
    "test:integration": "mocha test/integration/**/*.test.js",
    "test:unit": "mocha test/**/*.test.js --exclude test/integration/**/*.test.js",
    "lint": "sgmf-scripts --lint js",
    "upload": "sgmf-scripts --upload -- ",
    "uploadCartridge": "sgmf-scripts --uploadCartridge int_bloomreach_engagement && sgmf-scripts --uploadCartridge int_bloomreach_engagement_controllers && sgmf-scripts --uploadCartridge int_bloomreach_engagement_sfra",
    "compile:js": "sgmf-scripts --compile js"
  },
  "devDependencies": {
    "eslint": "^3.2.2",
    "eslint-config-airbnb-base": "^5.0.1",
    "eslint-plugin-import": "^1.12.0",
    "istanbul": "^0.4.4",
    "mocha": "^5.2.0",
    "sinon": "^1.17.4",
    "chai": "^3.5.0",
    "proxyquire": "1.7.4",
    "sgmf-scripts": "^3.1.0"
  },
  "browserslist": [
    "last 2 versions",
    "ie >= 10"
  ]
}
